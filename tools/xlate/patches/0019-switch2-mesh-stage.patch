+namespace Ryujinx.Graphics.Shader
+{
+    /// <summary>
+    /// A Switch 2 mesh program, translated as a vertex program whose stage buffer (ISBE) accesses go to workgroup memory.
+    /// Its entry point becomes a MeshEXT one that hands that memory to Vulkan after the program ran. Layout of the shared
+    /// array, in words: the attribute region, one word per map byte, the primitive count. Set per translation by the tool.
+    /// </summary>
+    public static class NxMesh
+    {
+        [System.ThreadStatic] public static int Threads;       // 0: not a mesh program
+        [System.ThreadStatic] public static int MaxVertices;
+        [System.ThreadStatic] public static int MaxPrimitives;
+        [System.ThreadStatic] public static int[] Lines;       // per line: generic * 4 + element, or -1 - system bit
+        [System.ThreadStatic] public static bool IsTask;       // a task program: the shared array is its payload
+        [System.ThreadStatic] public static int PayloadWords;  // task payload, 0 for a mesh program without a task
+
+        public static bool Active => Threads != 0;
+        public static int AttributeWords => (MaxVertices + 31) / 32 * Lines.Length * 32;
+        public static int MapWords => 4 + 3 * MaxPrimitives;
+        public static int PayloadBase => AttributeWords + MapWords + 1;
+        public static int SharedBytes => IsTask ? PayloadWords * 4 : (PayloadBase + PayloadWords) * 4;
+    }
+}
