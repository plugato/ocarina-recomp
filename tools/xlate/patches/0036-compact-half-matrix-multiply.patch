+        public static void Hmma(EmitterContext context)
+        {
+            // Pseudo instruction of the NVN 2 lowering (Eglantine lower_to_maxwell.h, HMMA with LoweringOptions.tensor):
+            // HMMA.16816/.1688.F16 as 0x5d30 | Rd | Ra << 8 | Rb << 20 | Rc << 39 | 1 << 48 | (K == 8) << 49.
+            // ShufflePass turns it into a call to one shared helper per K (HelperFunctionManager).
+            ulong raw = context.CurrOp.RawOpCode;
+
+            if (((raw >> 48) & 1) == 0 || ((raw >> 50) & 3) != 0)
+            {
+                context.TranslatorContext.GpuAccessor.Log($"Invalid HMMA pseudo instruction 0x{raw:x16}.");
+                return;
+            }
+
+            int rd = (int)(raw & 0xff);
+            int ra = (int)((raw >> 8) & 0xff);
+            int rb = (int)((raw >> 20) & 0xff);
+            int rc = (int)((raw >> 39) & 0xff);
+            bool k8 = ((raw >> 49) & 1) != 0;
+
+            Operand Src(int reg, int offset, bool used = true)
+            {
+                return !used || reg == RegisterConsts.RegisterZeroIndex ? Const(0) : GetSrcReg(context, reg + offset);
+            }
