+
+        private static bool ReadsWritableMemory(IAstNode node)
+        {
+            if (node is not AstOperation op)
+            {
+                return false;
+            }
+
+            Instruction inst = op.Inst & Instruction.Mask;
+
+            if (inst == Instruction.ImageLoad ||
+                (inst == Instruction.Load && op.StorageKind is not (StorageKind.None or StorageKind.ConstantBuffer) &&
+                 !op.StorageKind.IsInputOrOutput()))
+            {
+                return true;
+            }
+
+            for (int index = 0; index < op.SourcesCount; index++)
+            {
+                if (ReadsWritableMemory(op.GetSource(index)))
+                {
+                    return true;
+                }
+            }
+
             return false;
         }
 
