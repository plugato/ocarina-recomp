#version 450
// Frame interpolation (oot_motion.c): the scene's depth, copied to an R32F image of our own while it is still the
// scene's (the game's UI draws over its memory later in the frame).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1, r32f) uniform writeonly image2D dst;
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(g, imageSize(dst)))) return;
    imageStore(dst, g, vec4(texelFetch(src, g, 0).r));
}
